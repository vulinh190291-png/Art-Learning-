.page-container.data-v-0eb4e14b {
  background-color: #f3f4f6;
  padding-bottom: 140rpx;
}
.card.data-v-0eb4e14b {
  background-color: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.loading-state.data-v-0eb4e14b, .empty-state.data-v-0eb4e14b {
  padding-top: 30vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.info-section .price-line.data-v-0eb4e14b {
  color: #c7522a;
  margin-bottom: 16rpx;
}
.info-section .price-line .symbol.data-v-0eb4e14b {
  font-size: 32rpx;
}
.info-section .price-line .price.data-v-0eb4e14b {
  font-size: 48rpx;
  font-weight: bold;
}
.info-section .name.data-v-0eb4e14b {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}
.seller-section.data-v-0eb4e14b {
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.seller-section .left.data-v-0eb4e14b {
  display: flex;
  align-items: center;
}
.seller-section .left .avatar.data-v-0eb4e14b {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
