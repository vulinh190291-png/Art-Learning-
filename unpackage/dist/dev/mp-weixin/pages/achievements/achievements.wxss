.page-container.data-v-062a4f72 {
  padding: 24rpx;
  background-color: #f3f4f6;
  min-height: 100vh;
}
.loading-state.data-v-062a4f72, .empty-state.data-v-062a4f72 {
  padding-top: 30vh;
}
.achievements-grid.data-v-062a4f72 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}
.badge-card.data-v-062a4f72 {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.badge-card .badge-icon.data-v-062a4f72 {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
  transition: filter 0.3s ease;
}
.badge-card .badge-name.data-v-062a4f72 {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  transition: color 0.3s ease;
}
.badge-card .badge-desc.data-v-062a4f72 {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  transition: color 0.3s ease;
}
.badge-card:not(.earned) .badge-icon.data-v-062a4f72 {
  filter: grayscale(100%);
}
.badge-card:not(.earned) .badge-name.data-v-062a4f72, .badge-card:not(.earned) .badge-desc.data-v-062a4f72 {
  color: #c0c4cc;
}
.badge-card .lock-overlay.data-v-062a4f72 {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(100, 100, 100, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.badge-card:not(.earned):hover .lock-overlay.data-v-062a4f72 {
  opacity: 1;
}